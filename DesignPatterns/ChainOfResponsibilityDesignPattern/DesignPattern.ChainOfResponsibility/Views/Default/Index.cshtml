@model CustomerProcessViewModel

@{
    Layout = null;
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

<div class="container">
    <div class="mt-3">
        <form method="post">
            <div class="mt-3">
                <label>Müşteri Adı Soyadı</label>
                <input type="text" class="form-control" asp-for="Name" />
            </div>
            <div class="mt-3">
                <label>Çekilecek Miktar</label>
                <input type="text" class="form-control" asp-for="Amount" />
            </div>
            <div class="mt-3">
                <button class="btn btn-warning">Para Çek</button>
            </div>
        </form>
    </div>
</div>
