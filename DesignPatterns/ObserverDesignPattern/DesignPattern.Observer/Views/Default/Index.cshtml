@model RegisterViewModel
@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

<div class="d-flex justify-content-center mt-3">
    <div class="card col-8 p-3">
        <div class="card-header">
            <h3 class="card-title text-center text-uppercase">Kullanıcı Kayıt Formu</h3>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mt-3">
                    <label>Adınız</label>
                    <input type="text" asp-for="Name" class="form-control" />
                </div>
                <div class="mt-3">
                    <label>Soyadınız</label>
                    <input type="text" asp-for="Surname" class="form-control" />
                </div>
                <div class="mt-3">
                    <label>Kullanıcı Adınız</label>
                    <input type="text" asp-for="Username" class="form-control" />
                </div>
                <div class="mt-3">
                    <label>Mail Adresiniz</label>
                    <input type="email" asp-for="Email" class="form-control" />
                </div>
                <div class="mt-3">
                    <label>Şehriniz</label>
                    <input type="text" asp-for="District" class="form-control" />
                </div>
                <div class="mt-3">
                    <label>Şifreniz</label>
                    <input type="password" asp-for="Password" class="form-control" />
                </div>
                <div class="mt-3">
                    <button class="btn btn-outline-secondary w-100">Kayıt Ol</button>
                </div>
            </form>
        </div>
    </div>
</div>